{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/event-attendance-check",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/buddy-follow-up",
      "schedule": "0 9 * * *"
    }
  ]
}
